; =========================================
; Tasking Runtime (Preemptive Multitasking)
; =========================================
; Ada tasking support for Z80
;
; Task model:
; - Up to 8 concurrent tasks (configurable)
; - Preemptive scheduling via timer interrupt (IM 1 at RST 38h)
; - Round-robin with priority support
; - Entry calls for task synchronization (rendezvous)
;
; TCB (Task Control Block) structure - 16 bytes:
;   +0:  saved_sp (2 bytes) - task's stack pointer
;   +2:  stack_base (2 bytes) - bottom of task's stack
;   +4:  stack_size (2 bytes) - size of stack allocation
;   +6:  state (1 byte) - 0=inactive, 1=ready, 2=waiting, 3=terminated
;   +7:  priority (1 byte) - higher = more important
;   +8:  next (2 bytes) - next TCB in ready/wait queue
;   +10: prev (2 bytes) - previous TCB in queue
;   +12: task_id (2 bytes) - unique task identifier
;   +14: delay_ticks (2 bytes) - ticks remaining for delay

    .Z80    ; Enable Z80 instruction set

    CSEG

; Export all public routines (long names for backwards compatibility)
    PUBLIC _TASK_INIT
    PUBLIC _TASK_CREATE
    PUBLIC _TASK_YIELD
    PUBLIC _TASK_TERMINATE
    PUBLIC _TASK_DELAY
    PUBLIC _TASK_DELAY_UNTIL
    PUBLIC _TASK_ABORT
    PUBLIC _ENTRY_CALL
    PUBLIC _ENTRY_ACCEPT
    PUBLIC _ENTRY_ACCEPT_END
    PUBLIC _SELECT_START
    PUBLIC _SELECT_WAIT
    PUBLIC _SELECT_END
    ; _PROTECTED_LOCK and _PROTECTED_UNLOCK are in protlock.mac
    PUBLIC _task_current
    PUBLIC _tick_count

; Export 8-character aliases (for um80 compatibility and lowering.py)
    PUBLIC _TASK_INI        ; alias for _TASK_INIT
    PUBLIC _TASK_CRE        ; alias for _TASK_CREATE
    PUBLIC _TASK_YLD        ; alias for _TASK_YIELD
    PUBLIC _TASK_TRM        ; alias for _TASK_TERMINATE
    PUBLIC _TASK_DLY        ; alias for _TASK_DELAY
    PUBLIC _TASK_DLU        ; alias for _TASK_DELAY_UNTIL
    PUBLIC _TASK_ABT        ; alias for _TASK_ABORT
    PUBLIC _TASK_WAI        ; alias for _TASK_WAIT_ALL
    PUBLIC _ENTRY_CL        ; alias for _ENTRY_CALL
    PUBLIC _ENTRY_AC        ; alias for _ENTRY_ACCEPT
    PUBLIC _ENTRY_AE        ; alias for _ENTRY_ACCEPT_END
    PUBLIC _SELC_ST         ; alias for _SELECT_START
    PUBLIC _SELC_WT         ; alias for _SELECT_WAIT
    PUBLIC _SELC_EN         ; alias for _SELECT_END
    PUBLIC _TASK_WAIT_ALL
    PUBLIC _TSK_CLBL        ; T'Callable
    PUBLIC _TSK_TERM        ; T'Terminated
    PUBLIC _TSK_SELF        ; Current task's ID
    PUBLIC _TSK_PRNT        ; Parent frame pointer
    PUBLIC _TASK_ACT_INC    ; Increment activation counter
    PUBLIC _TASK_ACT_DEC    ; Signal activation complete
    PUBLIC _TASK_ACT_WAIT   ; Wait for activations
    ; _PROT_LCK and _PROT_ULK are in protlock.mac
    PUBLIC _PROT_ENQ        ; protected entry queue
    PUBLIC _PROT_REB        ; re-evaluate barriers
    PUBLIC _REQUEUE         ; requeue statement
    PUBLIC _select_term_idx ; terminate index for SELECT_WAIT
    PUBLIC _SELC_TRM        ; alias
    PUBLIC _ENTRY_COND_CALL ; conditional entry call
    PUBLIC _ENTR_CND        ; alias for conditional entry call
    PUBLIC _select_entry_ids ; entry IDs for selective accept
    PUBLIC _select_entry_cnt ; entry count for selective accept
    PUBLIC _SELC_REG        ; register entry ID for selective accept
    PUBLIC _PAR_STR         ; parallel start
    PUBLIC _PAR_SST         ; parallel sequence start
    PUBLIC _PAR_SEN         ; parallel sequence end
    PUBLIC _PAR_END         ; parallel end
    PUBLIC _task_cur        ; alias for _task_current
    PUBLIC _tick_cnt        ; alias for _tick_count

; External dependencies
    EXTRN _heap_alloc
    EXTRN _raise_tasking_error

; =========================================
; Constants
; =========================================

; Task states
TASK_INACTIVE   EQU 0
TASK_READY      EQU 1
TASK_WAITING    EQU 2
TASK_TERMINATED EQU 3
TASK_ENTRY_WAIT EQU 4    ; waiting for entry call to complete
TASK_ACCEPT_WAIT EQU 5   ; waiting in accept statement
TASK_MASTER_WAIT EQU 6   ; parent waiting for children (TASK_WAIT_ALL)

; TCB (Task Control Block) field offsets
TCB_SAVED_SP    EQU 0    ; saved stack pointer (2 bytes)
TCB_STACK_BASE  EQU 2    ; base of task's stack (2 bytes)
TCB_STACK_SIZE  EQU 4    ; size of stack allocation (2 bytes)
TCB_STATE       EQU 6    ; task state (1 byte)
TCB_PRIORITY    EQU 7    ; task priority (1 byte)
TCB_NEXT        EQU 8    ; next TCB in queue (2 bytes)
TCB_PREV        EQU 10   ; prev TCB in queue (2 bytes)
TCB_TASK_ID     EQU 12   ; unique task identifier (2 bytes)
TCB_DELAY_TICKS EQU 14   ; ticks remaining for delay (2 bytes)
TCB_PARENT_IX   EQU 16   ; parent's frame pointer (2 bytes)

; Configuration
MAX_TASKS       EQU 8
TCB_SIZE        EQU 18
DEFAULT_STACK   EQU 256  ; bytes per task stack
TIME_SLICE      EQU 10   ; ticks per time slice
DEFAULT_PRIO    EQU 128  ; default task priority (mid-range)

; Entry queue structure (8 bytes per entry)
ENTRY_Q_NEXT     EQU 0    ; next entry in queue (2 bytes)
ENTRY_Q_CALLER   EQU 2    ; caller task TCB (2 bytes)
ENTRY_Q_ENTRY_ID EQU 4    ; entry ID being called (2 bytes)
ENTRY_Q_PARAMS   EQU 6    ; parameter block pointer (2 bytes)
ENTRY_Q_SIZE     EQU 8    ; size of queue entry
MAX_ENTRY_NODES  EQU 16

; =========================================
; Data Section
; =========================================

    DSEG

_task_current:
    DS 2            ; pointer to current task's TCB
_task_ready_head:
    DS 2            ; head of ready queue
_task_count:
    DS 1            ; number of active tasks
_task_next_id:
    DS 2            ; next task ID to assign
_tick_count:
    DS 2            ; system tick counter
_slice_remaining:
    DS 1            ; ticks left in current slice
_scheduler_lock:
    DS 1            ; non-zero = scheduler disabled
_old_rst38:
    DS 3            ; saved RST 38h handler (JP + 2-byte address)

; TCB array (MAX_TASKS * TCB_SIZE bytes)
_tcb_array:
    DS MAX_TASKS * TCB_SIZE

; Entry queue data
_entry_queue_head:
    DS 2            ; head of pending entry calls queue
_entry_free_list:
    DS 2            ; head of free node list
_entry_nodes:
    DS ENTRY_Q_SIZE * MAX_ENTRY_NODES
_rendezvous_caller:
    DS 2            ; TCB pointer of caller blocked during rendezvous
_activation_count:
    DS 2            ; number of tasks pending activation
_select_term_idx:
    DS 2            ; terminate alternative index for SELECT_WAIT
_cond_entry_node:
    DS 2            ; saved queue node for conditional entry call
_select_entry_ids:
    DS 16           ; up to 8 entry IDs for selective accept (2 bytes each)
_select_entry_cnt:
    DS 1            ; number of entries registered for current select

; =========================================
; Code Section
; =========================================

    CSEG

; -----------------------------------------
; _TASK_INIT: Initialize tasking system
; Called once at program start
; -----------------------------------------
_TASK_INIT:
    di
    ; Clear TCB array
    ld HL, _tcb_array
    ld DE, _tcb_array + 1
    ld BC, MAX_TASKS * TCB_SIZE - 1
    ld (HL), 0
    ldir
    ; Set up main task as task 0 using IX for indexed access
    ld IX, _tcb_array
    ld HL, _tcb_array
    ld (_task_current), HL
    ld A, TASK_READY
    ld (IX+TCB_STATE), A       ; state = ready
    ld A, DEFAULT_PRIO
    ld (IX+TCB_PRIORITY), A    ; priority = default
    ld (IX+TCB_TASK_ID), 1     ; task_id low byte
    ld (IX+TCB_TASK_ID+1), 0   ; task_id high byte
    ld HL, 2
    ld (_task_next_id), HL
    ld A, 1
    ld (_task_count), A
    ; Initialize activation counter
    ld HL, 0
    ld (_activation_count), HL
    ; Initialize entry queue free list
    call _entry_init
    ; Install timer ISR at RST 38h (IM 1)
    ; Save old RST 38h handler (JP instruction at 0x0038)
    ld A, (0x0038)
    ld (_old_rst38), A         ; save opcode byte
    ld HL, (0x0039)
    ld (_old_rst38+1), HL      ; save target address
    ; Write full JP instruction: C3 lo hi
    ld A, 0C3H                 ; JP opcode
    ld (0x0038), A
    ld HL, _TIMER_ISR
    ld (0x0039), HL
    im 1
    ei
    ret

; -----------------------------------------
; _TIMER_ISR: Timer interrupt service routine
; Called by RST 38h for preemptive task switching
; -----------------------------------------
_TIMER_ISR:
    push AF
    push BC
    push DE
    push HL
    push IX
    push IY
    ex AF, AF'
    exx
    push AF
    push BC
    push DE
    push HL
    ; Increment tick count
    ld HL, (_tick_count)
    inc HL
    ld (_tick_count), HL
    ; Update delay counters for waiting tasks
    call _update_delays
    ; Check scheduler lock
    ld A, (_scheduler_lock)
    or A
    jr NZ, _timer_isr_exit
    ; Decrement time slice
    ld A, (_slice_remaining)
    dec A
    ld (_slice_remaining), A
    jr NZ, _timer_isr_exit
    ; Time slice expired - switch tasks
    call _do_schedule
_timer_isr_exit:
    pop HL
    pop DE
    pop BC
    pop AF
    exx
    ex AF, AF'
    pop IY
    pop IX
    pop HL
    pop DE
    pop BC
    pop AF
    ei
    reti

; -----------------------------------------
; _update_delays: Decrement delay counters
; Wake tasks whose delays have expired
; -----------------------------------------
_update_delays:
    ld HL, _tcb_array
    ld B, MAX_TASKS
_ud_loop:
    push HL
    pop IX
    ld A, (IX+TCB_STATE)
    cp TASK_WAITING
    jr NZ, _ud_next
    ; Check if delay has expired
    ld E, (IX+TCB_DELAY_TICKS)
    ld D, (IX+TCB_DELAY_TICKS+1)
    ld A, D
    or E
    jr Z, _ud_wake        ; zero ticks = wake immediately
    dec DE
    ld (IX+TCB_DELAY_TICKS), E
    ld (IX+TCB_DELAY_TICKS+1), D
    ld A, D
    or E
    jr NZ, _ud_next       ; still waiting
_ud_wake:
    ; Delay expired - wake the task
    ld A, TASK_READY
    ld (IX+TCB_STATE), A
_ud_next:
    ld DE, TCB_SIZE
    add HL, DE
    djnz _ud_loop
    ret

; -----------------------------------------
; _do_schedule: Find next ready task and switch to it
; -----------------------------------------
_do_schedule:
    ; Save current task's SP
    ld HL, (_task_current)
    ld A, H
    or L
    jr Z, _sched_no_current
    ; save SP at (HL) - TCB+0
    push HL           ; save TCB address
    ld HL, 0
    add HL, SP        ; HL = SP (current value + 2 for the push)
    inc HL
    inc HL            ; adjust for the push we just did
    ex DE, HL         ; DE = adjusted SP
    pop HL            ; HL = TCB address
    ld (HL), E        ; store SP low
    inc HL
    ld (HL), D        ; store SP high
_sched_no_current:
    ; Simple round-robin: move to next task
    ld HL, (_task_current)
    ld DE, TCB_SIZE
    add HL, DE
    ; Check if past end of array
    ld DE, _tcb_array + (MAX_TASKS * TCB_SIZE)
    or A
    sbc HL, DE
    add HL, DE
    jr C, _sched_check_task
    ; Wrap to start
    ld HL, _tcb_array
_sched_check_task:
    ; Check if this task is ready or master-waiting (HL = TCB address)
    push HL
    pop IX           ; IX = TCB address for indexed access
    ld A, (IX+TCB_STATE)  ; get task state
    cp TASK_READY
    jr Z, _sched_found
    cp TASK_MASTER_WAIT
    jr Z, _sched_found
    ; Try next task (simple search)
    ld DE, TCB_SIZE
    add HL, DE
    ; Check bounds again — wrap if past end
    ld DE, _tcb_array + (MAX_TASKS * TCB_SIZE)
    or A
    sbc HL, DE
    add HL, DE
    jr C, _sched_no_wrap
    ld HL, _tcb_array      ; wrap to start
_sched_no_wrap:
    ; Check if we've come back to where we started (_task_current)
    ld DE, (_task_current)
    or A
    sbc HL, DE
    add HL, DE
    jr NZ, _sched_check_task   ; keep scanning if not back to start
    ; Full cycle done — check current task itself (it may still be READY)
    push HL
    pop IX
    ld A, (IX+TCB_STATE)
    cp TASK_READY
    jr Z, _sched_found
    cp TASK_MASTER_WAIT
    jr Z, _sched_found
    ; No ready task found at all — enable interrupts and wait
    ei
    halt             ; wait for interrupt (timer tick)
    di
    ; After interrupt, scan again from the beginning
    ld HL, _tcb_array
    jr _sched_check_task
_sched_found:
    ; Switch to new task
    ld (_task_current), HL
    ; restore SP from (HL) - TCB+0
    ld E, (HL)        ; load SP low
    inc HL
    ld D, (HL)        ; load SP high
    ex DE, HL         ; HL = new SP value
    ld SP, HL         ; restore SP
    ld A, TIME_SLICE
    ld (_slice_remaining), A
    ret

; -----------------------------------------
; _TASK_CREATE: Create a new task
; Input: HL = entry point address
; Output: HL = task ID (0 on failure)
; -----------------------------------------
_TASK_CREATE:
    ; Input: HL = entry point address
    ; Output: HL = task ID (0 on failure)
    ; Preserves: IX, DE, BC
    push IX         ; save caller's frame pointer
    push DE
    push BC
    push HL         ; save entry point [SP+0]
    ; Find free TCB slot
    ld HL, _tcb_array
    ld B, MAX_TASKS
_tc_find_slot:
    push HL
    pop IX           ; IX = TCB for indexed access
    ld A, (IX+TCB_STATE)
    cp TASK_INACTIVE
    jr Z, _tc_found_slot
    ld DE, TCB_SIZE
    add HL, DE
    djnz _tc_find_slot
    ; No free slot
    pop HL          ; discard entry point
    ld HL, 0
    pop BC
    pop DE
    pop IX
    ret
_tc_found_slot:
    ; IX = free TCB, HL = TCB address
    ; Stack: entry_point, BC, DE, IX, ret_addr
    push HL         ; save TCB address [SP+0], entry_point [SP+2]
    ; Allocate task stack from heap
    ld HL, DEFAULT_STACK
    call _heap_alloc
    ld A, H
    or L
    jr Z, _tc_fail
    ; HL = stack base (allocated memory)
    ; Stack: TCB_addr, entry_point, BC, DE, IX, ret_addr
    pop IX          ; IX = TCB address
    ld (IX+TCB_STACK_BASE), L
    ld (IX+TCB_STACK_BASE+1), H
    ld (IX+TCB_STACK_SIZE), LOW DEFAULT_STACK
    ld (IX+TCB_STACK_SIZE+1), HIGH DEFAULT_STACK
    ; Calculate top of stack (HL = base + size)
    ld DE, DEFAULT_STACK
    add HL, DE      ; HL = top of task stack
    ; Write _task_term_handler as return address at top of stack
    dec HL
    ld (HL), HIGH _task_term_handler
    dec HL
    ld (HL), LOW _task_term_handler
    ; Write entry point above term handler
    pop DE          ; DE = entry point (from saved HL)
    dec HL
    ld (HL), D      ; entry point high byte
    dec HL
    ld (HL), E      ; entry point low byte
    ; HL = initial SP for this task
    ld (IX+TCB_SAVED_SP), L
    ld (IX+TCB_SAVED_SP+1), H
    ; Store parent's frame pointer (caller's IX) in TCB
    ; Stack: BC, DE, IX_caller, ret_addr
    ; IX_caller is at SP+4
    ld HL, 4
    add HL, SP
    ld E, (HL)
    inc HL
    ld D, (HL)                   ; DE = caller's IX value
    ld (IX+TCB_PARENT_IX), E
    ld (IX+TCB_PARENT_IX+1), D
    ; Set task state to READY
    ld (IX+TCB_STATE), TASK_READY
    ld (IX+TCB_PRIORITY), DEFAULT_PRIO
    ; Assign task ID
    ld HL, (_task_next_id)
    ld (IX+TCB_TASK_ID), L
    ld (IX+TCB_TASK_ID+1), H
    push HL         ; save task ID for return
    inc HL
    ld (_task_next_id), HL
    ; Increment task count
    ld A, (_task_count)
    inc A
    ld (_task_count), A
    ; Return task ID in HL
    pop HL          ; HL = task ID
    pop BC
    pop DE
    pop IX          ; restore caller's frame pointer
    ret
_tc_fail:
    ; Stack: TCB_addr, entry_point, BC, DE, IX, ret_addr
    pop HL          ; discard TCB
    pop HL          ; discard entry point
    ld HL, 0        ; return 0 (failure)
    pop BC
    pop DE
    pop IX
    ret

; Task termination handler - called when task body returns
_task_term_handler:
    jp _TASK_TERMINATE

; -----------------------------------------
; _TASK_ACT_INC: Increment activation counter
; Called before creating tasks in a declarative region.
; -----------------------------------------
_TASK_ACT_INC:
    push HL
    ld HL, (_activation_count)
    inc HL
    ld (_activation_count), HL
    pop HL
    ret

; -----------------------------------------
; _TASK_ACT_DEC: Signal task activation complete
; Called by task body after declarative part is elaborated.
; Decrements activation counter.
; -----------------------------------------
_TASK_ACT_DEC:
    push HL
    ld HL, (_activation_count)
    dec HL
    ld (_activation_count), HL
    pop HL
    ret

; -----------------------------------------
; _TASK_ACT_WAIT: Wait for all pending activations to complete
; Called at begin of block/subprogram that created tasks.
; Yields until activation_count reaches 0.
; -----------------------------------------
_TASK_ACT_WAIT:
    push HL
_taw_loop:
    ld HL, (_activation_count)
    ld A, H
    or L
    jr Z, _taw_done
    ; Still pending activations - yield and re-check
    pop HL
    call _TASK_YIELD
    push HL
    jr _taw_loop
_taw_done:
    pop HL
    ret

; -----------------------------------------
; _TASK_YIELD: Voluntarily yield to scheduler
; -----------------------------------------
_TASK_YIELD:
    push IX         ; save caller's frame pointer
    di
    call _do_schedule
    ei
    pop IX
    ret

; -----------------------------------------
; _TASK_TERMINATE: Terminate current task
; -----------------------------------------
_TASK_TERMINATE:
    push IX         ; save caller's frame pointer
    di
    ld HL, (_task_current)
    push HL
    pop IX            ; IX = TCB pointer
    ld A, TASK_TERMINATED
    ld (IX+TCB_STATE), A
    ; Decrement task count
    ld A, (_task_count)
    dec A
    ld (_task_count), A
    ; Schedule another task
    call _do_schedule
    ei
    pop IX
    ret

; -----------------------------------------
; _TASK_DELAY: Delay for HL ticks
; If HL=0, just yield once (don't block forever)
; -----------------------------------------
_TASK_DELAY:
    push IX         ; save caller's frame pointer
    di
    ; Check for zero delay — just yield
    ld A, H
    or L
    jr NZ, _td_nonzero
    ; Zero delay — yield once and return
    call _do_schedule
    ei
    pop IX
    ret
_td_nonzero:
    ; Ensure at least 1 tick delay
    push HL           ; save ticks to delay
    ld HL, (_task_current)
    push HL
    pop IX            ; IX = TCB pointer
    pop DE            ; DE = ticks to delay
    ld (IX+TCB_DELAY_TICKS), E
    ld (IX+TCB_DELAY_TICKS+1), D
    ld A, TASK_WAITING
    ld (IX+TCB_STATE), A
    call _do_schedule
    ei
    pop IX
    ret

; -----------------------------------------
; _TASK_DELAY_UNTIL: Delay until tick count reaches HL
; -----------------------------------------
_TASK_DELAY_UNTIL:
    push IX         ; save caller's frame pointer
    di
    ld DE, (_tick_count)
    or A
    sbc HL, DE      ; ticks to wait = target - current
    jr NC, _delay_until_positive
    ld HL, 0        ; already past, no delay
_delay_until_positive:
    push HL           ; save ticks to delay
    ld HL, (_task_current)
    push HL
    pop IX            ; IX = TCB pointer
    pop DE            ; DE = ticks to delay
    ld (IX+TCB_DELAY_TICKS), E
    ld (IX+TCB_DELAY_TICKS+1), D
    ld A, TASK_WAITING
    ld (IX+TCB_STATE), A
    call _do_schedule
    ei
    pop IX
    ret

; -----------------------------------------
; _TASK_ABORT: Abort a task
; Input: HL = task ID to abort
; -----------------------------------------
_TASK_ABORT:
    push IX         ; save caller's frame pointer
    di
    push HL
    call _find_task_by_id
    ld A, H
    or L
    jr Z, _abort_not_found
    push HL
    pop IX
    ; Check if task is already terminated
    ld A, (IX+TCB_STATE)
    cp TASK_TERMINATED
    jr Z, _abort_done
    cp TASK_INACTIVE
    jr Z, _abort_done
    ; Mark task as terminated
    ld A, TASK_TERMINATED
    ld (IX+TCB_STATE), A
    ; Decrement task count
    ld A, (_task_count)
    dec A
    ld (_task_count), A
_abort_done:
_abort_not_found:
    pop HL
    ei
    pop IX
    ret

; -----------------------------------------
; Entry queue management
; -----------------------------------------

; _entry_init: Initialize entry queue free list
_entry_init:
    ld HL, _entry_nodes
    ld (_entry_free_list), HL
    ld DE, ENTRY_Q_SIZE
    ld B, MAX_ENTRY_NODES - 1
_ei_loop:
    push HL
    add HL, DE       ; next node
    ex DE, HL        ; DE = next node
    pop HL           ; HL = current node
    push HL
    pop IX
    ld (IX+ENTRY_Q_NEXT), E
    ld (IX+ENTRY_Q_NEXT+1), D
    ex DE, HL        ; HL = next node
    ld DE, ENTRY_Q_SIZE
    djnz _ei_loop
    ; Terminate last node
    push HL
    pop IX
    xor A
    ld (IX+ENTRY_Q_NEXT), A
    ld (IX+ENTRY_Q_NEXT+1), A
    ; Initialize queue head to empty
    xor A
    ld (_entry_queue_head), A
    ld (_entry_queue_head+1), A
    ; Initialize rendezvous caller to 0
    ld (_rendezvous_caller), A
    ld (_rendezvous_caller+1), A
    ret

; _entry_alloc: Allocate a queue node
; Output: HL = node pointer (0 if none)
_entry_alloc:
    ld HL, (_entry_free_list)
    ld A, H
    or L
    ret Z            ; no free nodes
    ; Remove from free list
    push HL
    pop IX
    ld E, (IX+ENTRY_Q_NEXT)
    ld D, (IX+ENTRY_Q_NEXT+1)
    ld (_entry_free_list), DE
    ret

; _entry_free: Free a queue node
; Input: HL = node pointer
_entry_free:
    push HL
    pop IX
    ld DE, (_entry_free_list)
    ld (IX+ENTRY_Q_NEXT), E
    ld (IX+ENTRY_Q_NEXT+1), D
    ld (_entry_free_list), HL
    ret

; -----------------------------------------
; _ENTRY_CALL: Call a task entry (rendezvous)
; Stack: entry_id, task_id, params_ptr
; Blocks caller until entry is accepted
; -----------------------------------------
_ENTRY_CALL:
    di
    push IX
    ld IX, 0
    add IX, SP
    ; Stack frame: IX+0=saved_IX, IX+2=ret_addr, IX+4=entry_id, IX+6=task_id, IX+8=params
    ; Read all params now while IX points to our frame
    ld L, (IX+6)     ; task_id
    ld H, (IX+7)
    push HL          ; save task_id
    ld E, (IX+4)     ; entry_id
    ld D, (IX+5)
    push DE          ; save entry_id
    ld L, (IX+8)     ; params_ptr
    ld H, (IX+9)
    push HL          ; save params_ptr
    ; Allocate queue node
    call _entry_alloc
    ld A, H
    or L
    jr Z, _ec_fail
    ; HL = queue node, set IX to it (frame pointer no longer needed)
    push HL
    pop IX           ; IX = queue node
    ; Set caller TCB
    ld HL, (_task_current)
    ld (IX+ENTRY_Q_CALLER), L
    ld (IX+ENTRY_Q_CALLER+1), H
    ; Fill from saved values on stack
    pop HL           ; params_ptr
    ld (IX+ENTRY_Q_PARAMS), L
    ld (IX+ENTRY_Q_PARAMS+1), H
    pop HL           ; entry_id
    ld (IX+ENTRY_Q_ENTRY_ID), L
    ld (IX+ENTRY_Q_ENTRY_ID+1), H
    ; Add to pending queue (at head)
    ld HL, (_entry_queue_head)
    ld (IX+ENTRY_Q_NEXT), L
    ld (IX+ENTRY_Q_NEXT+1), H
    push IX
    pop HL
    ld (_entry_queue_head), HL
    ; Mark caller as ENTRY_WAIT
    ld HL, (_task_current)
    push HL
    pop IY           ; IY = caller TCB
    ld A, TASK_ENTRY_WAIT
    ld (IY+TCB_STATE), A
    ; Wake target task if it's waiting on accept
    pop HL           ; task_id
    call _find_task_by_id
    ld A, H
    or L
    jr Z, _ec_schedule
    push HL
    pop IY           ; IY = target TCB
    ld A, (IY+TCB_STATE)
    cp TASK_ACCEPT_WAIT
    jr NZ, _ec_schedule
    ; Target is waiting for accept, wake it
    ld A, TASK_READY
    ld (IY+TCB_STATE), A
_ec_schedule:
    ; Schedule away from caller (blocks until rendezvous complete)
    call _do_schedule
    ; Rendezvous complete, restore frame pointer and return
    pop IX
    ei
    ret
_ec_fail:
    ; No queue node available - raise Tasking_Error
    pop HL
    pop HL
    pop HL
    pop IX
    ei
    jp _raise_tasking_error

; -----------------------------------------
; _ENTRY_ACCEPT: Accept an entry call
; Input: HL = entry_id to accept
; Output: HL = params_ptr from caller (0 if none)
; Blocks until a matching entry call arrives
; -----------------------------------------
_ENTRY_ACCEPT:
    di
    push IX
    push HL          ; save entry_id
_ea_check:
    ; Search queue for matching entry call
    ld HL, _entry_queue_head
    ld IY, 0         ; prev pointer (0 = head)
_ea_search:
    ld E, (HL)
    inc HL
    ld D, (HL)       ; DE = current node
    ld A, D
    or E
    jr Z, _ea_wait   ; queue empty, wait
    ; DE = node, check if entry_id matches
    push DE
    pop IX           ; IX = node
    ld L, (IX+ENTRY_Q_ENTRY_ID)
    ld H, (IX+ENTRY_Q_ENTRY_ID+1)
    ex (SP), HL      ; HL = wanted entry_id, stack = node entry_id
    pop DE           ; DE = node entry_id
    push HL          ; save wanted entry_id
    or A
    sbc HL, DE
    jr Z, _ea_found
    ; Not a match, move to next
    push IX
    pop IY           ; IY = prev (this node)
    push IX
    pop HL
    jr _ea_search
_ea_wait:
    ; No matching entry, block and wait
    ld HL, (_task_current)
    push HL
    pop IX
    ld A, TASK_ACCEPT_WAIT
    ld (IX+TCB_STATE), A
    call _do_schedule
    ; Woken up, check queue again
    jr _ea_check
_ea_found:
    ; IX = matching node, IY = prev node (or 0)
    ; Remove node from queue
    ld E, (IX+ENTRY_Q_NEXT)
    ld D, (IX+ENTRY_Q_NEXT+1)
    ; Check if prev is head
    push IY
    pop HL
    ld A, H
    or L
    jr NZ, _ea_unlink_mid
    ; Unlinking head
    ld (_entry_queue_head), DE
    jr _ea_unlinked
_ea_unlink_mid:
    ; IY = prev node
    ld (IY+ENTRY_Q_NEXT), E
    ld (IY+ENTRY_Q_NEXT+1), D
_ea_unlinked:
    ; Get params pointer to return
    ld L, (IX+ENTRY_Q_PARAMS)
    ld H, (IX+ENTRY_Q_PARAMS+1)
    push HL          ; save params
    ; Save caller TCB in _rendezvous_caller so _ENTRY_ACCEPT_END can wake it
    ld L, (IX+ENTRY_Q_CALLER)
    ld H, (IX+ENTRY_Q_CALLER+1)
    ld (_rendezvous_caller), HL
    ; Caller stays in ENTRY_WAIT state until accept body completes
    ; Free the queue node
    push IX
    pop HL
    call _entry_free
    ; Return params ptr
    pop HL           ; params
    pop DE           ; discard saved entry_id
    pop IX
    ei
    ret

; -----------------------------------------
; _ENTRY_ACCEPT_END: Mark end of accept body
; Wakes the caller task that was blocked during rendezvous
; -----------------------------------------
_ENTRY_ACCEPT_END:
    ; Wake the caller that was blocked during the accept body
    push IX          ; save caller's frame pointer
    ld HL, (_rendezvous_caller)
    ld A, H
    or L
    jr Z, _eae_done  ; no caller to wake (shouldn't happen)
    push HL
    pop IX
    ld A, TASK_READY
    ld (IX+TCB_STATE), A
    ; Clear rendezvous caller
    ld HL, 0
    ld (_rendezvous_caller), HL
_eae_done:
    pop IX           ; restore caller's frame pointer
    ret

; -----------------------------------------
; _ENTRY_COND_CALL: Conditional entry call (non-blocking)
; Stack: entry_id, task_id, params_ptr (same as _ENTRY_CALL)
; Output: HL = 0 if rendezvous happened, HL = 1 if not possible
; Does NOT block — takes else branch if entry can't be immediately serviced
; -----------------------------------------
_ENTRY_COND_CALL:
    di
    push IX
    ld IX, 0
    add IX, SP
    ; IX+0=saved_IX, IX+2=ret_addr, IX+4=entry_id, IX+6=task_id, IX+8=params
    ; Read all params
    ld L, (IX+6)     ; task_id
    ld H, (IX+7)
    push HL          ; save task_id
    ld E, (IX+4)     ; entry_id
    ld D, (IX+5)
    push DE          ; save entry_id
    ld L, (IX+8)     ; params_ptr
    ld H, (IX+9)
    push HL          ; save params_ptr
    ; Allocate queue node
    call _entry_alloc
    ld A, H
    or L
    jr Z, _ecc_no_alloc
    ; HL = queue node
    push HL
    pop IX           ; IX = queue node
    ; Set caller TCB
    ld HL, (_task_current)
    ld (IX+ENTRY_Q_CALLER), L
    ld (IX+ENTRY_Q_CALLER+1), H
    ; Fill from saved values on stack
    pop HL           ; params_ptr
    ld (IX+ENTRY_Q_PARAMS), L
    ld (IX+ENTRY_Q_PARAMS+1), H
    pop HL           ; entry_id
    ld (IX+ENTRY_Q_ENTRY_ID), L
    ld (IX+ENTRY_Q_ENTRY_ID+1), H
    ; Add to queue head
    ld HL, (_entry_queue_head)
    ld (IX+ENTRY_Q_NEXT), L
    ld (IX+ENTRY_Q_NEXT+1), H
    push IX
    pop HL
    ld (_entry_queue_head), HL
    ; Save our queue node address for later check
    ld (_cond_entry_node), HL
    ; Stay READY (don't set ENTRY_WAIT)
    ; Wake target if it's in ACCEPT_WAIT
    pop HL           ; task_id
    call _find_task_by_id
    ld A, H
    or L
    jr Z, _ecc_yield
    push HL
    pop IY
    ld A, (IY+TCB_STATE)
    cp TASK_ACCEPT_WAIT
    jr NZ, _ecc_yield
    ld A, TASK_READY
    ld (IY+TCB_STATE), A
_ecc_yield:
    ; Yield once to let target run
    call _do_schedule
    ; Back from yield — check if our node was consumed
    ; Search entry queue for our saved node pointer
    ld DE, (_cond_entry_node)    ; DE = our node address
    ld HL, _entry_queue_head
_ecc_search:
    ld C, (HL)
    inc HL
    ld B, (HL)       ; BC = current node ptr
    ld A, B
    or C
    jr Z, _ecc_consumed  ; end of queue — our node was consumed
    ; Check if BC == DE (our node)
    ld A, C
    cp E
    jr NZ, _ecc_search_next
    ld A, B
    cp D
    jr Z, _ecc_still_queued
_ecc_search_next:
    ; Move to next: HL = &(BC->next)
    push BC
    pop IX
    ld HL, 0
    add HL, BC       ; HL = node address (ENTRY_Q_NEXT is at offset 0)
    jr _ecc_search
_ecc_consumed:
    ; Node was consumed — rendezvous happened, success!
    pop IX
    ei
    ld HL, 0
    ret
_ecc_still_queued:
    ; Node still in queue — rendezvous didn't happen
    ; Remove our node from the queue
    ; We need to find the node and unlink it
    ; DE = our node address
    ; Walk queue again to find prev
    ld HL, _entry_queue_head
    ld IY, 0         ; prev = NULL (meaning head)
_ecc_remove_search:
    ld C, (HL)
    inc HL
    ld B, (HL)       ; BC = current node
    ld A, C
    cp E
    jr NZ, _ecc_rm_next
    ld A, B
    cp D
    jr Z, _ecc_rm_found
_ecc_rm_next:
    push BC
    pop IY           ; prev = current node
    ld HL, 0
    add HL, BC       ; HL = &current->next
    jr _ecc_remove_search
_ecc_rm_found:
    ; BC = our node (== DE), IY = prev (or 0 if head)
    push DE
    pop IX           ; IX = our node
    ld E, (IX+ENTRY_Q_NEXT)
    ld D, (IX+ENTRY_Q_NEXT+1)   ; DE = next node
    ; Check if we're at head
    push IY
    pop HL
    ld A, H
    or L
    jr NZ, _ecc_rm_mid
    ; Unlinking from head
    ld (_entry_queue_head), DE
    jr _ecc_rm_done
_ecc_rm_mid:
    ld (IY+ENTRY_Q_NEXT), E
    ld (IY+ENTRY_Q_NEXT+1), D
_ecc_rm_done:
    ; Free the node
    push IX
    pop HL
    call _entry_free
    ; Return failure
    pop IX
    ei
    ld HL, 1
    ret
_ecc_no_alloc:
    ; No queue node available — return failure (take else branch)
    pop HL           ; params_ptr
    pop HL           ; entry_id
    pop HL           ; task_id
    pop IX
    ei
    ld HL, 1
    ret

; -----------------------------------------
; Select statement support
; -----------------------------------------

; _SELECT_START: Begin a select statement
; Resets the entry count for selective accept
_SELECT_START:
    xor A
    ld (_select_entry_cnt), A
    ret

; _SELC_REG: Register an entry ID for selective accept
; Stack: entry_id (2 bytes) at SP+2 (after return addr)
; Called once per accept alternative in a selective accept
_SELC_REG:
    push IX
    ld IX, 0
    add IX, SP
    ; IX+0=saved_IX, IX+2=ret_addr, IX+4=entry_id
    ld L, (IX+4)
    ld H, (IX+5)     ; HL = entry_id
    push DE
    ld A, (_select_entry_cnt)
    ld E, A
    ld D, 0
    push HL          ; save entry_id
    ld HL, _select_entry_ids
    add HL, DE
    add HL, DE       ; HL = &_select_entry_ids[count] (2 bytes each)
    pop DE           ; DE = entry_id
    ld (HL), E
    inc HL
    ld (HL), D
    ; Increment count
    ld A, (_select_entry_cnt)
    inc A
    ld (_select_entry_cnt), A
    pop DE
    pop IX
    ret

; _SELECT_WAIT: Wait for one of the registered alternatives
; Reads _select_term_idx for terminate alternative index (0xFFFF = no terminate)
; Reads _select_entry_ids[0.._select_entry_cnt-1] for registered entry IDs
; Output: HL = selected alternative index (matching entry index, or terminate index)
_SELECT_WAIT:
    di
    push IX
_sw_check:
    ; Search queue for any entry matching our registered entry IDs
    ld A, (_select_entry_cnt)
    or A
    jr Z, _sw_no_entries   ; no entries registered, check terminate
    ; For each registered entry ID, search the queue
    ld B, A               ; B = entry count
    ld C, 0               ; C = current alternative index
    ld IX, _select_entry_ids
_sw_try_entry:
    push BC
    push IX
    ; Get entry ID at IX
    ld L, (IX+0)
    ld H, (IX+1)          ; HL = wanted entry_id
    ; Search entry queue for this entry_id
    push HL
    ld HL, (_entry_queue_head)
_sw_q_search:
    ld A, H
    or L
    jr Z, _sw_q_not_found  ; end of queue
    push HL
    pop IY                ; IY = current node
    ld E, (IY+ENTRY_Q_ENTRY_ID)
    ld D, (IY+ENTRY_Q_ENTRY_ID+1)
    pop HL                ; HL = wanted entry_id
    push HL
    or A
    sbc HL, DE
    jr Z, _sw_q_match     ; found matching entry!
    add HL, DE            ; restore HL
    ; Move to next node
    ld L, (IY+ENTRY_Q_NEXT)
    ld H, (IY+ENTRY_Q_NEXT+1)
    jr _sw_q_search
_sw_q_match:
    ; Found! Alternative index is in C
    pop HL                ; discard saved entry_id
    pop IX
    pop BC
    ; Return C as the selected alternative index
    ld L, C
    ld H, 0
    pop IX
    ei
    ret
_sw_q_not_found:
    pop HL                ; discard saved entry_id
    pop IX
    pop BC
    ; Try next entry
    inc IX
    inc IX                ; advance to next entry_id (2 bytes)
    inc C                 ; next alternative index
    djnz _sw_try_entry
_sw_no_entries:
    ; No matching entries pending — check terminate/else alternative
    ld HL, (_select_term_idx)
    ; Check for 0xFFFF (no terminate) — must block
    ld A, H
    cp 0FFH
    jr NZ, _sw_has_alt  ; high byte != FF, it's a valid alternative index
    ld A, L
    cp 0FFH
    jr Z, _sw_block     ; 0xFFFF = no terminate/else, must block
    cp 0FEH
    jr Z, _sw_else      ; 0xFFFE = else alternative, return immediately
    ; High byte FF but not FFFF or FFFE — treat as block
    jr _sw_block
_sw_has_alt:
    ; HL is a valid terminate alternative index — check if should terminate
    call _sw_check_terminate
    ld A, H
    or L
    jr NZ, _sw_terminate  ; HL != 0 means should terminate
_sw_block:
    ; Block and wait for entry call
    ld HL, (_task_current)
    push HL
    pop IX
    ld A, TASK_ACCEPT_WAIT
    ld (IX+TCB_STATE), A
    call _do_schedule
    ; Woken up — check again
    jr _sw_check
_sw_else:
    ; Else alternative — return 0xFFFE immediately
    ld HL, 0FFFEH
    pop IX
    ei
    ret
_sw_terminate:
    ; Fire terminate alternative — return terminate_index in HL
    ld HL, (_select_term_idx)
    pop IX
    ei
    ret

; _sw_check_terminate: Check if current task should terminate
; Returns HL = 1 if should terminate, 0 if not
; A task should terminate when all other tasks are either:
; INACTIVE, TERMINATED, ACCEPT_WAIT, or MASTER_WAIT
_sw_check_terminate:
    push IX
    push BC
    ld DE, (_task_current)   ; save current TCB for comparison
    ld IX, _tcb_array
    ld B, MAX_TASKS
_swct_loop:
    push IX
    pop HL           ; HL = current TCB addr
    ; Skip self
    or A
    sbc HL, DE
    jr Z, _swct_next
    ld A, (IX+TCB_STATE)
    cp TASK_INACTIVE
    jr Z, _swct_next
    cp TASK_TERMINATED
    jr Z, _swct_next
    cp TASK_ACCEPT_WAIT
    jr Z, _swct_next
    cp TASK_MASTER_WAIT
    jr Z, _swct_next
    ; Found a task that is READY or ENTRY_WAIT — cannot terminate
    pop BC
    pop IX
    ld HL, 0         ; return 0 (don't terminate)
    ret
_swct_next:
    push DE           ; preserve DE across add
    ld DE, TCB_SIZE
    add IX, DE
    pop DE            ; restore current TCB ptr
    djnz _swct_loop
    ; All other tasks are done/waiting — should terminate
    pop BC
    pop IX
    ld HL, 1         ; return 1 (terminate)
    ret

; _SELECT_END: End a select statement
_SELECT_END:
    ret

; -----------------------------------------
; _find_task_by_id: Find TCB for task ID
; Input: HL = task_id
; Output: HL = TCB pointer (0 if not found)
; Clobbers: IX, DE, B
; -----------------------------------------
_find_task_by_id:
    push IX
    ld IX, _tcb_array
    ld B, MAX_TASKS
_ftbi_loop:
    ld A, (IX+TCB_TASK_ID)
    cp L
    jr NZ, _ftbi_next
    ld A, (IX+TCB_TASK_ID+1)
    cp H
    jr Z, _ftbi_found
_ftbi_next:
    ld DE, TCB_SIZE
    add IX, DE
    djnz _ftbi_loop
    ld HL, 0
    pop IX
    ret
_ftbi_found:
    push IX
    pop HL           ; HL = TCB pointer
    pop IX
    ret

; =========================================
; Protected Object Support
; =========================================
; Protected objects provide mutual exclusion for their operations.
; On Z80, we use DI/EI for efficient mutual exclusion since there
; is only a single CPU and no memory protection hardware.
;
; The lock value is stored at offset 0 of the protected object and
; contains the nesting count (0 = unlocked, >0 = locked).

PROT_LOCK_OFFSET EQU 0  ; Lock byte at offset 0 of protected object

; _twa_wake_accept: Wake all ACCEPT_WAIT tasks to READY
; So they can re-check terminate conditions
_twa_wake_accept:
    push IX
    push BC
    ld IX, _tcb_array + TCB_SIZE  ; skip task 0 (main)
    ld B, MAX_TASKS - 1
_twaw_loop:
    ld A, (IX+TCB_STATE)
    cp TASK_ACCEPT_WAIT
    jr NZ, _twaw_next
    ; Wake this task
    ld A, TASK_READY
    ld (IX+TCB_STATE), A
_twaw_next:
    ld DE, TCB_SIZE
    add IX, DE
    djnz _twaw_loop
    pop BC
    pop IX
    ret

; NOTE: _PROTECTED_LOCK and _PROTECTED_UNLOCK are now in protlock.mac

; -----------------------------------------
; _TASK_WAIT_ALL: Wait for all non-main tasks to terminate
; Called at scope exit (DECLARE blocks, subprogram exit)
; when child tasks were created in that scope.
; Blocks main task until all child tasks are TERMINATED or INACTIVE.
; -----------------------------------------
_TASK_WAIT_ALL:
    di
    push IX
    push BC
_twa_check:
    ; Scan TCB array for any non-main, non-terminated tasks
    ld IX, _tcb_array + TCB_SIZE  ; skip task 0 (main)
    ld B, MAX_TASKS - 1
_twa_loop:
    ld A, (IX+TCB_STATE)
    cp TASK_INACTIVE
    jr Z, _twa_next
    cp TASK_TERMINATED
    jr Z, _twa_next
    ; Found a live task - wake ACCEPT_WAIT tasks, set MASTER_WAIT, yield
    ; Wake all ACCEPT_WAIT tasks so they can check terminate condition
    call _twa_wake_accept
    ld HL, (_task_current)
    push HL
    pop IY
    ld A, TASK_MASTER_WAIT
    ld (IY+TCB_STATE), A
    pop BC
    pop IX
    ei
    call _TASK_YIELD
    di
    ; Restore READY state
    ld HL, (_task_current)
    push HL
    pop IY
    ld A, TASK_READY
    ld (IY+TCB_STATE), A
    push IX
    push BC
    jr _twa_check
_twa_next:
    ld DE, TCB_SIZE
    push IX
    pop HL
    add HL, DE
    push HL
    pop IX
    djnz _twa_loop
    ; All child tasks done
    pop BC
    pop IX
    ei
    ret

; -----------------------------------------
; _TSK_CLBL: Check if task is callable (T'Callable)
; Input: task_id on stack at (SP+2) [caller pushes before call]
; Output: HL = 1 (callable) or 0 (not callable)
; A task is callable unless it is completed or terminated.
; -----------------------------------------
_TSK_CLBL:
    push DE
    push BC
    ; Load task_id from stack: ret_addr(2) + DE(2) + BC(2) = SP+6
    ld HL, 6
    add HL, SP
    ld A, (HL)
    inc HL
    ld H, (HL)
    ld L, A
    call _find_task_by_id
    ld A, H
    or L
    jr Z, _tclbl_false    ; task not found = not callable
    push HL
    pop IX
    ld A, (IX+TCB_STATE)
    cp TASK_TERMINATED
    jr Z, _tclbl_false
    cp TASK_INACTIVE
    jr Z, _tclbl_false
    ; Task is callable
    ld HL, 1
    pop BC
    pop DE
    ret
_tclbl_false:
    ld HL, 0
    pop BC
    pop DE
    ret

; -----------------------------------------
; _TSK_TERM: Check if task is terminated (T'Terminated)
; Input: task_id on stack at (SP+2) [caller pushes before call]
; Output: HL = 1 (terminated) or 0 (not terminated)
; -----------------------------------------
_TSK_TERM:
    push DE
    push BC
    ; Load task_id from stack: ret_addr(2) + DE(2) + BC(2) = SP+6
    ld HL, 6
    add HL, SP
    ld A, (HL)
    inc HL
    ld H, (HL)
    ld L, A
    call _find_task_by_id
    ld A, H
    or L
    jr Z, _tterm_true     ; task not found = consider terminated
    push HL
    pop IX
    ld A, (IX+TCB_STATE)
    cp TASK_TERMINATED
    jr Z, _tterm_true
    cp TASK_INACTIVE
    jr Z, _tterm_true
    ; Task is not terminated
    ld HL, 0
    pop BC
    pop DE
    ret
_tterm_true:
    ld HL, 1
    pop BC
    pop DE
    ret

; =========================================
; 8-Character Aliases (for um80 compatibility)
; =========================================

_TASK_INI:  jp _TASK_INIT
_TASK_CRE:  jp _TASK_CREATE
_TASK_YLD:  jp _TASK_YIELD
_TASK_TRM:  jp _TASK_TERMINATE
_TASK_DLY:  jp _TASK_DELAY
_TASK_DLU:  jp _TASK_DELAY_UNTIL
_TASK_ABT:  jp _TASK_ABORT
_TASK_WAI:  jp _TASK_WAIT_ALL
_ENTRY_CL:  jp _ENTRY_CALL
_ENTRY_AC:  jp _ENTRY_ACCEPT
_ENTRY_AE:  jp _ENTRY_ACCEPT_END
_SELC_ST:   jp _SELECT_START
_SELC_WT:   jp _SELECT_WAIT
_SELC_EN:   jp _SELECT_END
_ENTR_CND:  jp _ENTRY_COND_CALL
_SELC_TRM:  ; alias for _select_term_idx (data label, not code)
; _PROT_LCK and _PROT_ULK are in protlock.mac

; Additional stubs for protected types and parallel blocks
_PROT_ENQ:
    ; Protected entry queue: caller is blocked waiting for barrier.
    ; Yield CPU so other tasks can modify the protected state
    ; and make the barrier true.
    call _do_schedule
    ret

_PROT_REB:
    ; Re-evaluate barriers - stub
    ret

_REQUEUE:
    ; Requeue statement - stub
    pop DE              ; return address
    pop HL              ; entry_ptr
    pop BC              ; with_abort_flag
    push DE             ; restore return
    ret

_PAR_STR:
    ; Parallel start - stub (sequential execution)
    ret

_PAR_SST:
    ; Parallel sequence start - stub
    ret

_PAR_SEN:
    ; Parallel sequence end - stub
    ret

_PAR_END:
    ; Parallel end - stub
    ret

; -----------------------------------------
; _TSK_SELF: Get current task's ID
; Output: HL = current task's task_id
; -----------------------------------------
_TSK_SELF:
    push IX
    ld HL, (_task_current)
    push HL
    pop IX
    ld L, (IX+TCB_TASK_ID)
    ld H, (IX+TCB_TASK_ID+1)
    pop IX
    ret

; _TSK_PRNT: Get current task's parent frame pointer
; Output: HL = parent's IX value at task creation time
; -----------------------------------------
_TSK_PRNT:
    push IX
    ld HL, (_task_current)
    push HL
    pop IX
    ld L, (IX+TCB_PARENT_IX)
    ld H, (IX+TCB_PARENT_IX+1)
    pop IX
    ret

; Data aliases
    DSEG
_task_cur:  EQU _task_current
_tick_cnt:  EQU _tick_count

    END
