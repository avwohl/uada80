; =========================================
; MP/M II Tasking Runtime
; =========================================
; Ada tasking support using MP/M II operating system primitives
;
; This runtime implements Ada tasking by mapping:
; - Ada tasks to MP/M II subprocesses (P_CREATE)
; - Task entries to MP/M II linked message queues (Q_MAKE/Q_READ/Q_WRITE)
; - Delay statements to P_DELAY
; - Protected types to MX queues (mutual exclusion via Q_READ/Q_WRITE)
;
; MP/M II BDOS Functions Used:
; 134 Q_MAKE       - Create message queue (takes QCB address)
; 135 Q_OPEN       - Open message queue (takes UQCB address)
; 136 Q_DELETE     - Delete message queue
; 137 Q_READ       - Read from queue, blocking (takes UQCB address)
; 138 Q_CREAD      - Conditional read, non-blocking (takes UQCB address)
; 139 Q_WRITE      - Write to queue, blocking (takes UQCB address)
; 140 Q_CWRITE     - Conditional write, non-blocking (takes UQCB address)
; 141 P_DELAY      - Delay process
; 142 P_DISPATCH   - Yield to scheduler
; 143 P_TERM       - Terminate process
; 144 P_CREATE     - Create subprocess (takes PD address)
; 145 P_PRIORITY   - Set process priority
; 156 P_PDADR      - Get process descriptor address
; 157 P_ABORT      - Abort a process

    .Z80    ; Enable Z80 instruction set

    CSEG

; Export all public routines (8-char limit for um80)
    PUBLIC _TASK_INI        ; Initialize tasking system
    PUBLIC _TASK_CRE        ; Create a new task (subprocess)
    PUBLIC _TASK_YLD        ; Yield to scheduler
    PUBLIC _TASK_TRM        ; Terminate current task
    PUBLIC _TASK_DLY        ; Delay for ticks
    PUBLIC _TASK_DLU        ; Delay until time
    PUBLIC _TASK_ABT        ; Abort a task
    PUBLIC _ENTRY_CL        ; Call a task entry
    PUBLIC _ENTRY_AC        ; Accept an entry call
    PUBLIC _ENTRY_AE        ; Accept end
    PUBLIC _SELC_ST         ; Select start
    PUBLIC _SELC_WT         ; Select wait
    PUBLIC _SELC_EN         ; Select end
    PUBLIC _PROT_LCK        ; Protected type lock (MX queue read)
    PUBLIC _PROT_ULK        ; Protected type unlock (MX queue write)
    PUBLIC _PROT_ENQ        ; Protected entry queue
    PUBLIC _PROT_REB        ; Protected re-evaluate barriers
    PUBLIC _REQUEUE         ; Requeue statement
    PUBLIC _PAR_STR         ; Parallel start
    PUBLIC _PAR_SST         ; Parallel sequence start
    PUBLIC _PAR_SEN         ; Parallel sequence end
    PUBLIC _PAR_END         ; Parallel end
    PUBLIC _tick_cnt        ; System tick counter
    PUBLIC _task_cur        ; Current task ID

; External dependencies
    EXTRN _heap_alloc
    EXTRN _raise_tasking_error

; =========================================
; BDOS Function Numbers
; =========================================

BDOS        EQU 5           ; BDOS entry point

; MP/M II specific functions
B_QMAKE     EQU 134         ; Create message queue
B_QOPEN     EQU 135         ; Open message queue
B_QDELETE   EQU 136         ; Delete message queue
B_QREAD     EQU 137         ; Read from queue (blocking)
B_QCREAD    EQU 138         ; Conditional read
B_QWRITE    EQU 139         ; Write to queue (blocking)
B_QCWRITE   EQU 140         ; Conditional write
B_PDELAY    EQU 141         ; Delay process
B_PDISPATCH EQU 142         ; Yield to scheduler
B_PTERM     EQU 143         ; Terminate process
B_PCREATE   EQU 144         ; Create subprocess
B_PPRIORITY EQU 145         ; Set priority
B_PPDADR    EQU 156         ; Get process descriptor address
B_PABORT    EQU 157         ; Abort a process

; =========================================
; Configuration
; =========================================

MAX_TASKS       EQU 8       ; Maximum concurrent tasks
MAX_ENTRIES     EQU 32      ; Maximum entry queues
DEFAULT_PRIO    EQU 128     ; Default task priority (mid-range)
TASK_STACK_SIZE EQU 256     ; Default task stack size
NMBMSGS         EQU 4       ; Entry queue message slot count

; =========================================
; MP/M II Process Descriptor (from PROCES.LIT)
; =========================================
; Total: 52 bytes
;   process_header:
;     PL(2), STATUS(1), PRIORITY(1), STKPTR(2)
;   then:
;     NAME(8), CONSOLE(1), MEMSEG(1), B(2), THREAD(2)
;   bdos_save:
;     DISKDMA(2), DISKSLCT(1), DCNT(2), SEARCHL(1), SEARCHA(2),
;     DRVACT(2), REGISTERS(20), SCRATCH(2)

PD_SIZE         EQU 52
PD_PL           EQU 0       ; 2 bytes - process link
PD_STATUS       EQU 2       ; 1 byte
PD_PRIORITY     EQU 3       ; 1 byte
PD_STKPTR       EQU 4       ; 2 bytes - stack pointer
PD_NAME         EQU 6       ; 8 bytes
PD_CONSOLE      EQU 14      ; 1 byte
PD_MEMSEG       EQU 15      ; 1 byte
PD_B            EQU 16      ; 2 bytes
PD_THREAD       EQU 18      ; 2 bytes
PD_DISKDMA      EQU 20      ; 2 bytes
PD_DISKSLCT     EQU 22      ; 1 byte
PD_DCNT         EQU 23      ; 2 bytes
PD_SEARCHL      EQU 25      ; 1 byte
PD_SEARCHA      EQU 26      ; 2 bytes
PD_DRVACT       EQU 28      ; 2 bytes
PD_REGISTERS    EQU 30      ; 20 bytes
PD_SCRATCH      EQU 50      ; 2 bytes

; =========================================
; MP/M II Queue Control Block (from QUEUE.LIT)
; =========================================
; Linked queue format (used when MSGLEN >= 3):
;   QL(2), NAME(8), MSGLEN(2), NMBMSGS(2),
;   DQPH(2), NQPH(2), MH(2), MT(2), BH(2),
;   BUFFER((MSGLEN+2)*NMBMSGS bytes)

QCB_QL          EQU 0       ; 2 bytes - queue link
QCB_NAME        EQU 2       ; 8 bytes - queue name
QCB_MSGLEN      EQU 10      ; 2 bytes - message length
QCB_NMBMSGS     EQU 12      ; 2 bytes - number of message slots
QCB_DQPH        EQU 14      ; 2 bytes - dequeue process head
QCB_NQPH        EQU 16      ; 2 bytes - enqueue process head
QCB_MH          EQU 18      ; 2 bytes - message head
QCB_MT          EQU 20      ; 2 bytes - message tail
QCB_BH          EQU 22      ; 2 bytes - buffer (free list) head
QCB_BUF         EQU 24      ; buffer starts here
QCB_HDR_SIZE    EQU 24      ; header size before buffer

; User Queue Control Block (UQCB) for Q_OPEN/Q_READ/Q_WRITE
UQCB_PTR        EQU 0       ; 2 bytes - QCB pointer (filled by Q_OPEN)
UQCB_MSGADR     EQU 2       ; 2 bytes - user message buffer address
UQCB_NAME       EQU 4       ; 8 bytes - queue name
UQCB_SIZE       EQU 12

; =========================================
; Data Structures
; =========================================
;
; Task Descriptor (TD) - 32 bytes per task
; Used to track Ada task state and map to MP/M process
;   +0:  pd_addr (2 bytes) - address of this task's PD
;   +2:  entry_queue (2 bytes) - pointer to entry queue descriptor
;   +4:  state (1 byte) - Ada task state
;   +5:  priority (1 byte) - task priority
;   +6:  parent_id (2 bytes) - parent task ID
;   +8:  task_name (8 bytes) - name for debugging
;   +16: stack_base (2 bytes) - base of allocated stack
;   +18: reserved (14 bytes)
;
; Entry Queue Descriptor (EQD) - 20 bytes per entry
; Maps an Ada entry to an MP/M message queue
;   +0:  qcb_addr (2 bytes) - address of heap-allocated QCB
;   +2:  entry_id (2 bytes) - Ada entry identifier
;   +4:  task_id (2 bytes) - owning task ID
;   +6:  msg_count (1 byte) - number of buffered messages
;   +7:  msg_size (1 byte) - size of each message
;   +8:  queue_name (8 bytes) - MP/M queue name
;   +16: reserved (4 bytes)
;
; Entry Message (EM) - 16 bytes
; Message sent through queue for entry call
;   +0:  caller_id (2 bytes) - calling task ID
;   +2:  entry_id (2 bytes) - entry being called
;   +4:  params_ptr (2 bytes) - pointer to parameters
;   +6:  result_ptr (2 bytes) - pointer for return values
;   +8:  status (1 byte) - call status
;   +9:  reserved (7 bytes)

; Task states
TS_INACTIVE     EQU 0       ; Task not created
TS_ACTIVATING   EQU 1       ; Task being created
TS_READY        EQU 2       ; Ready to run
TS_RUNNING      EQU 3       ; Currently executing
TS_WAITING      EQU 4       ; Waiting (delay, entry, etc.)
TS_COMPLETED    EQU 5       ; Task finished
TS_TERMINATED   EQU 6       ; Task aborted

; Task descriptor offsets
TD_PD_ADDR      EQU 0
TD_ENTRY_QUEUE  EQU 2
TD_STATE        EQU 4
TD_PRIORITY     EQU 5
TD_PARENT_ID    EQU 6
TD_TASK_NAME    EQU 8
TD_STACK_BASE   EQU 16
TD_SIZE         EQU 32

; Entry queue descriptor offsets
EQD_QCB_ADDR    EQU 0
EQD_ENTRY_ID    EQU 2
EQD_TASK_ID     EQU 4
EQD_MSG_COUNT   EQU 6
EQD_MSG_SIZE    EQU 7
EQD_QUEUE_NAME  EQU 8
EQD_SIZE        EQU 20

; Entry message offsets
EM_CALLER_ID    EQU 0
EM_ENTRY_ID     EQU 2
EM_PARAMS_PTR   EQU 4
EM_RESULT_PTR   EQU 6
EM_STATUS       EQU 8
EM_SIZE         EQU 16

; Slot size in linked queue buffer: message + 2-byte link
EM_SLOT_SIZE    EQU EM_SIZE + 2

; =========================================
; Data Section
; =========================================

    DSEG

_task_cur:
    DS 2                    ; Current task ID (index into task array)
_tick_cnt:
    DS 2                    ; Tick counter (read from MP/M TOD)
_task_count:
    DS 1                    ; Number of active tasks
_next_task_id:
    DS 2                    ; Next task ID to assign
_next_entry_id:
    DS 2                    ; Next entry ID to assign

; Task descriptor array
_task_array:
    DS MAX_TASKS * TD_SIZE

; Per-task Process Descriptors (each task needs its own PD)
_pd_array:
    DS MAX_TASKS * PD_SIZE

; Entry queue descriptor array
_entry_array:
    DS MAX_ENTRIES * EQD_SIZE

; Temporary message buffer for entry calls
_entry_msg:
    DS EM_SIZE

; Shared UQCB for queue operations
_uqcb:
    DS UQCB_SIZE

; Abort Parameter Block for P_ABORT
_apb:
    DS 2                    ; +0: Process ID (console << 8 | process)
    DS 2                    ; +2: Termination code

; Queue message buffer (shared, for reading)
_qmsg_buf:
    DS EM_SIZE

; MX queue message buffer (2 bytes for lock token)
_mx_msg_buf:
    DS 2

; =========================================
; Code Section
; =========================================

    CSEG

; -----------------------------------------
; _TASK_INI: Initialize tasking system
; Called once at program start
; -----------------------------------------
_TASK_INI:
    push HL
    push DE
    push BC

    ; Clear task descriptor array
    ld HL, _task_array
    ld DE, _task_array + 1
    ld BC, MAX_TASKS * TD_SIZE - 1
    ld (HL), 0
    ldir

    ; Clear PD array
    ld HL, _pd_array
    ld DE, _pd_array + 1
    ld BC, MAX_TASKS * PD_SIZE - 1
    ld (HL), 0
    ldir

    ; Clear entry queue array
    ld HL, _entry_array
    ld DE, _entry_array + 1
    ld BC, MAX_ENTRIES * EQD_SIZE - 1
    ld (HL), 0
    ldir

    ; Initialize main task (task 0) - represents the main program
    ld IX, _task_array
    ld (IX+TD_STATE), TS_RUNNING
    ld (IX+TD_PRIORITY), DEFAULT_PRIO
    ; Store PD address for main task (slot 0 of PD array)
    ld HL, _pd_array
    ld (IX+TD_PD_ADDR), L
    ld (IX+TD_PD_ADDR+1), H

    ; Initialize counters
    ld A, 1
    ld (_task_count), A
    ld HL, 1
    ld (_next_task_id), HL
    ld HL, 1
    ld (_next_entry_id), HL
    xor A
    ld (_task_cur), A
    ld (_task_cur+1), A

    pop BC
    pop DE
    pop HL
    ret

; -----------------------------------------
; _TASK_CRE: Create a new task (subprocess)
; Input: HL = entry point address
;        DE = task name pointer (8 chars, can be 0)
; Output: HL = task ID (0 on failure)
; -----------------------------------------
_TASK_CRE:
    push IX
    push IY
    push BC
    push DE             ; save task name
    push HL             ; save entry point

    ; Find free task slot
    ld IX, _task_array
    ld B, MAX_TASKS
    xor A
    ld C, A             ; C = slot index
_tc_find:
    ld A, (IX+TD_STATE)
    cp TS_INACTIVE
    jr Z, _tc_found
    ld DE, TD_SIZE
    add IX, DE
    inc C
    djnz _tc_find

    ; No free slot
    pop HL
    pop DE
    ld HL, 0
    pop BC
    pop IY
    pop IX
    ret

_tc_found:
    ; IX = task descriptor, C = slot index
    ld (IX+TD_STATE), TS_ACTIVATING
    ld (IX+TD_PRIORITY), DEFAULT_PRIO

    ; Get current task as parent
    ld HL, (_task_cur)
    ld (IX+TD_PARENT_ID), L
    ld (IX+TD_PARENT_ID+1), H

    ; Store task name if provided
    pop HL              ; entry point
    pop DE              ; task name
    ld A, D
    or E
    jr Z, _tc_no_name

    ; Copy task name (8 chars)
    push IX
    pop IY              ; IY = task descriptor
    push HL             ; save entry point
    push BC             ; save slot index in C
    ld HL, TD_TASK_NAME
    push IY
    pop BC              ; BC = task descriptor base
    add HL, BC          ; HL = &task_name
    ex DE, HL           ; DE = dest, HL = source (task name)
    ld BC, 8
    ldir
    pop BC              ; restore C = slot index
    pop HL              ; restore entry point
    jr _tc_setup_pd

_tc_no_name:
    ; Default name "TASK_nn "
    push IX
    pop IY
    push HL             ; save entry point
    ld (IY+TD_TASK_NAME), 'T'
    ld (IY+TD_TASK_NAME+1), 'A'
    ld (IY+TD_TASK_NAME+2), 'S'
    ld (IY+TD_TASK_NAME+3), 'K'
    ld (IY+TD_TASK_NAME+4), '_'
    ld A, C
    add A, '0'
    ld (IY+TD_TASK_NAME+5), A
    ld (IY+TD_TASK_NAME+6), ' '
    ld (IY+TD_TASK_NAME+7), ' '
    pop HL              ; restore entry point

_tc_setup_pd:
    ; HL = entry point, IX = task descriptor, C = slot index
    ; Calculate PD address: _pd_array + C * PD_SIZE
    push HL             ; save entry point
    push IX             ; save task descriptor
    ld A, C
    ld H, 0
    ld L, A
    ; PD_SIZE = 52, multiply: L * 52
    ; 52 = 32 + 16 + 4
    push HL             ; save L
    add HL, HL          ; *2
    add HL, HL          ; *4
    push HL             ; save *4
    add HL, HL          ; *8
    add HL, HL          ; *16
    push HL             ; save *16
    add HL, HL          ; *32
    pop DE              ; DE = *16
    add HL, DE          ; *48
    pop DE              ; DE = *4
    add HL, DE          ; *52
    pop DE              ; discard saved L
    ld DE, _pd_array
    add HL, DE          ; HL = PD address for this slot

    ; Save PD address in task descriptor
    pop IX              ; IX = task descriptor
    ld (IX+TD_PD_ADDR), L
    ld (IX+TD_PD_ADDR+1), H

    push IX             ; save task descriptor again
    push HL
    pop IY              ; IY = PD address

    ; Clear the PD
    push HL
    pop DE
    inc DE              ; DE = PD + 1
    push HL             ; save PD base
    ld BC, PD_SIZE - 1
    ld (HL), 0
    ldir
    pop HL              ; HL = PD base
    push HL
    pop IY              ; IY = PD base

    ; Set PD.PL = 0 (not linked, single process)
    ld (IY+PD_PL), 0
    ld (IY+PD_PL+1), 0

    ; Set PD.STATUS = 0 (ready to run)
    ld (IY+PD_STATUS), 0

    ; Set PD.PRIORITY
    ld (IY+PD_PRIORITY), DEFAULT_PRIO

    ; Copy process name from task descriptor
    pop IX              ; IX = task descriptor
    push IX
    push IY             ; save PD
    push IX
    pop HL
    ld DE, TD_TASK_NAME
    add HL, DE          ; HL = source (task name in TD)
    pop IY              ; IY = PD
    push IY
    pop DE
    push HL             ; save source
    ld HL, PD_NAME
    add HL, DE          ; HL = dest (PD name field)
    ex DE, HL           ; DE = dest
    pop HL              ; HL = source
    ld BC, 8
    ldir

    ; Set NAME(2) bit 7 to disable BDOS stack swap (shared segment)
    push IY
    pop HL
    ld DE, PD_NAME + 2
    add HL, DE          ; HL = &PD.NAME[2]
    ld A, (HL)
    or 80H              ; Set bit 7
    ld (HL), A

    ; Get parent's MEMSEG and CONSOLE via BDOS 156 (P_PDADR)
    push IY             ; save child PD
    ld C, B_PPDADR
    call BDOS           ; HL = parent PD address
    push HL
    pop IX              ; IX = parent PD
    pop IY              ; IY = child PD

    ; Copy CONSOLE from parent
    ld A, (IX+PD_CONSOLE)
    ld (IY+PD_CONSOLE), A

    ; Copy MEMSEG from parent (same memory bank)
    ld A, (IX+PD_MEMSEG)
    ld (IY+PD_MEMSEG), A

    ; Now allocate stack for the new task
    pop IX              ; IX = task descriptor
    pop HL              ; HL = entry point
    push HL
    push IX

    ld HL, TASK_STACK_SIZE
    call _heap_alloc
    ld A, H
    or L
    jp Z, _tc_fail

    ; HL = stack base address
    ; Save stack base in task descriptor
    pop IX              ; IX = task descriptor
    push IX
    ld (IX+TD_STACK_BASE), L
    ld (IX+TD_STACK_BASE+1), H

    ; Calculate stack top = base + TASK_STACK_SIZE
    ld DE, TASK_STACK_SIZE
    add HL, DE          ; HL = stack top

    ; Fill stack with debug pattern 0xC7C7
    push HL             ; save stack top
    ld L, (IX+TD_STACK_BASE)
    ld H, (IX+TD_STACK_BASE+1)
    ld D, H
    ld E, L
    inc DE
    ld BC, TASK_STACK_SIZE - 1
    ld (HL), 0C7H
    ldir
    pop HL              ; HL = stack top

    ; Place entry point address at top of stack (CLOCK.ASM pattern)
    ; Stack grows downward, so entry point goes at (stack_top - 2)
    dec HL
    dec HL              ; HL = stack_top - 2
    pop IX              ; IX = task descriptor
    push IX
    pop IY              ; IY = task descriptor (need IX for PD)
    pop DE              ; DE = entry point

    ; Store entry point at stack_top - 2
    ld (HL), E          ; low byte of entry point
    inc HL
    ld (HL), D          ; high byte of entry point
    dec HL              ; HL = stack_top - 2 (where STKPTR should point)

    ; Set PD.STKPTR = stack_top - 2
    push HL             ; save STKPTR value
    ld L, (IY+TD_PD_ADDR)
    ld H, (IY+TD_PD_ADDR+1)
    push HL
    pop IX              ; IX = PD address
    pop HL              ; HL = STKPTR value
    ld (IX+PD_STKPTR), L
    ld (IX+PD_STKPTR+1), H

    ; Call MP/M P_CREATE (BDOS 144) with DE = PD address
    push IX
    pop DE              ; DE = PD address
    push IY             ; save task descriptor
    ld C, B_PCREATE
    call BDOS

    ; A = 0 on success, non-zero on error
    or A
    jr NZ, _tc_fail2

    ; Success
    pop IX              ; IX = task descriptor
    ld (IX+TD_STATE), TS_READY

    ; Increment task count
    ld A, (_task_count)
    inc A
    ld (_task_count), A

    ; Return task ID (slot index in HL)
    ; Calculate: (IX - _task_array) / TD_SIZE
    push IX
    pop HL
    ld DE, _task_array
    or A
    sbc HL, DE
    ; HL = offset, divide by TD_SIZE (32 = 2^5)
    srl H
    rr L
    srl H
    rr L
    srl H
    rr L
    srl H
    rr L
    srl H
    rr L
    ; HL = task index

    pop BC
    pop IY
    pop IX
    ret

_tc_fail2:
    pop IX              ; IX = task descriptor
    ld (IX+TD_STATE), TS_INACTIVE
    ld HL, 0
    pop BC
    pop IY
    pop IX
    ret

_tc_fail:
    ; Stack: entry_point, task_descriptor
    pop IX              ; discard task descriptor
    pop HL              ; discard entry point
    ld (IX+TD_STATE), TS_INACTIVE
    ld HL, 0
    pop BC
    pop IY
    pop IX
    ret

; -----------------------------------------
; _TASK_YLD: Voluntarily yield to scheduler
; Calls MP/M P_DISPATCH
; -----------------------------------------
_TASK_YLD:
    ld C, B_PDISPATCH
    jp BDOS             ; Tail call

; -----------------------------------------
; _TASK_TRM: Terminate current task
; Calls MP/M P_TERM with D=FFH to preserve shared memory
; -----------------------------------------
_TASK_TRM:
    ; Mark task as completed
    ld HL, (_task_cur)
    call _get_task_desc
    ld A, H
    or L
    jr Z, _tt_do_term
    push HL
    pop IX
    ld (IX+TD_STATE), TS_COMPLETED

    ; Decrement task count
    ld A, (_task_count)
    dec A
    ld (_task_count), A

_tt_do_term:
    ; Call MP/M P_TERM
    ; D=FFH: don't free shared memory segment
    ; E=FFH: unconditional termination
    ld C, B_PTERM
    ld D, 0FFH
    ld E, 0FFH
    jp BDOS             ; Does not return

; -----------------------------------------
; _TASK_DLY: Delay for HL ticks
; Input: HL = number of ticks to delay
; -----------------------------------------
_TASK_DLY:
    ex DE, HL           ; DE = ticks
    ld C, B_PDELAY
    jp BDOS             ; Tail call

; -----------------------------------------
; _TASK_DLU: Delay until absolute time
; Input: HL = target tick count
; Computes relative delay and calls P_DELAY
; -----------------------------------------
_TASK_DLU:
    ; Get current tick count
    push HL             ; save target
    call _get_ticks
    pop DE              ; DE = target
    ex DE, HL           ; HL = target, DE = current
    or A
    sbc HL, DE          ; HL = target - current
    jr NC, _dlu_delay
    ld HL, 0            ; Already past, no delay
_dlu_delay:
    ex DE, HL           ; DE = ticks to delay
    ld C, B_PDELAY
    jp BDOS             ; Tail call

; -----------------------------------------
; _TASK_ABT: Abort a task
; Input: HL = task ID to abort
; -----------------------------------------
_TASK_ABT:
    push IX
    push HL             ; save task ID

    ; Get task descriptor
    call _get_task_desc
    ld A, H
    or L
    jr Z, _ta_done      ; Invalid task ID

    push HL
    pop IX

    ; Check if already terminated
    ld A, (IX+TD_STATE)
    cp TS_COMPLETED
    jr Z, _ta_done
    cp TS_TERMINATED
    jr Z, _ta_done
    cp TS_INACTIVE
    jr Z, _ta_done

    ; Set up abort parameter block
    ; APB+0 = pdadr, APB+2 = term code
    ld L, (IX+TD_PD_ADDR)
    ld H, (IX+TD_PD_ADDR+1)

    ld IX, _apb
    ld (IX+0), L        ; PD address low
    ld (IX+1), H        ; PD address high
    ld (IX+2), 1        ; Termination code (abort)
    ld (IX+3), 0

    ; Call MP/M P_ABORT
    ld C, B_PABORT
    ld DE, _apb
    call BDOS

    ; Mark task as terminated
    pop HL              ; restore task ID
    push HL
    call _get_task_desc
    push HL
    pop IX
    ld (IX+TD_STATE), TS_TERMINATED

    ; Decrement task count
    ld A, (_task_count)
    dec A
    ld (_task_count), A

_ta_done:
    pop HL
    pop IX
    ret

; -----------------------------------------
; _ENTRY_CL: Call a task entry
; Stack: [ret] entry_id, task_id, params_ptr
; Blocks caller until entry is accepted
; Uses UQCB for Q_OPEN and Q_WRITE
; -----------------------------------------
_ENTRY_CL:
    push IX
    push IY

    ; Set up stack frame
    ld IX, 0
    add IX, SP
    ; IX+4 = ret addr, IX+6 = entry_id, IX+8 = task_id, IX+10 = params_ptr

    ; Get parameters
    ld L, (IX+8)        ; task_id low
    ld H, (IX+9)        ; task_id high
    push HL             ; save task_id

    ld E, (IX+6)        ; entry_id low
    ld D, (IX+7)        ; entry_id high
    push DE             ; save entry_id

    ld L, (IX+10)       ; params_ptr low
    ld H, (IX+11)       ; params_ptr high
    push HL             ; save params_ptr

    ; Find or create entry queue for this entry
    pop BC              ; BC = params_ptr
    pop DE              ; DE = entry_id
    pop HL              ; HL = task_id
    push BC             ; save params_ptr
    push DE             ; save entry_id
    push HL             ; save task_id

    call _find_entry_queue
    ld A, H
    or L
    jp Z, _ec_error     ; No queue for this entry

    ; HL = entry queue descriptor
    push HL
    pop IY              ; IY = EQD

    ; Build entry message in _entry_msg
    ld IX, _entry_msg

    ; Set caller ID (current task)
    ld HL, (_task_cur)
    ld (IX+EM_CALLER_ID), L
    ld (IX+EM_CALLER_ID+1), H

    ; Set entry ID
    pop HL              ; task_id (discard)
    pop DE              ; entry_id
    ld (IX+EM_ENTRY_ID), E
    ld (IX+EM_ENTRY_ID+1), D

    ; Set params pointer
    pop HL              ; params_ptr
    ld (IX+EM_PARAMS_PTR), L
    ld (IX+EM_PARAMS_PTR+1), H

    ; Result pointer (same as params for in-out)
    ld (IX+EM_RESULT_PTR), L
    ld (IX+EM_RESULT_PTR+1), H

    ; Status = 0 (pending)
    xor A
    ld (IX+EM_STATUS), A

    ; Set up UQCB for queue operations
    ld IX, _uqcb

    ; Copy queue name from EQD to UQCB
    push IY
    pop HL
    ld DE, EQD_QUEUE_NAME
    add HL, DE          ; HL = queue name in EQD
    ld DE, _uqcb + UQCB_NAME
    ld BC, 8
    ldir

    ; Set message address to our entry message
    ld HL, _entry_msg
    ld (_uqcb + UQCB_MSGADR), HL

    ; Open queue (fills in UQCB_PTR)
    ld C, B_QOPEN
    ld DE, _uqcb
    call BDOS

    ; Write message to queue (blocking)
    ld C, B_QWRITE
    ld DE, _uqcb
    call BDOS

    ; Entry call complete
    pop IY
    pop IX
    ret

_ec_error:
    ; Clean up stack and raise tasking error
    pop HL
    pop HL
    pop HL
    pop IY
    pop IX
    jp _raise_tasking_error

; -----------------------------------------
; _ENTRY_AC: Accept an entry call
; Input: HL = entry_id to accept
; Output: HL = params_ptr from caller (0 if none)
; Blocks until a matching entry call arrives
; Uses UQCB for Q_OPEN and Q_READ
; -----------------------------------------
_ENTRY_AC:
    push IX
    push IY
    push HL             ; save entry_id

    ; Find entry queue for this entry on current task
    ld DE, (_task_cur)  ; task_id = current task
    call _find_entry_queue
    ld A, H
    or L
    jr Z, _ea_no_queue

    push HL
    pop IY              ; IY = EQD

    ; Set up UQCB
    ld IX, _uqcb

    ; Copy queue name from EQD to UQCB
    push IY
    pop HL
    ld DE, EQD_QUEUE_NAME
    add HL, DE
    ld DE, _uqcb + UQCB_NAME
    ld BC, 8
    ldir

    ; Set message address to our receive buffer
    ld HL, _qmsg_buf
    ld (_uqcb + UQCB_MSGADR), HL

    ; Open queue (fills in UQCB_PTR)
    ld C, B_QOPEN
    ld DE, _uqcb
    call BDOS

    ; Read message from queue (blocking)
    ld C, B_QREAD
    ld DE, _uqcb
    call BDOS

    ; Message received, return params pointer
    ld IX, _qmsg_buf
    ld L, (IX+EM_PARAMS_PTR)
    ld H, (IX+EM_PARAMS_PTR+1)

    pop DE              ; discard saved entry_id
    pop IY
    pop IX
    ret

_ea_no_queue:
    ; No queue - create one, then retry
    pop HL              ; entry_id
    ld DE, (_task_cur)  ; task_id
    call _create_entry_queue
    ; Try accept again
    pop IY
    pop IX
    jr _ENTRY_AC

; -----------------------------------------
; _ENTRY_AE: Mark end of accept body
; Called when accept body completes
; -----------------------------------------
_ENTRY_AE:
    ; In MP/M implementation, the caller is unblocked when Q_READ completes
    ; Nothing special needed here
    ret

; -----------------------------------------
; Select statement support
; -----------------------------------------

; _SELC_ST: Begin a select statement
_SELC_ST:
    ret

; _SELC_WT: Wait for one of the registered alternatives
; Polls each entry queue for current task using Q_CREAD.
; Returns index of first queue with a pending message.
; Input: Stack contains array of entry_ids and count
; Output: HL = index of selected alternative
_SELC_WT:
    push IX
    push IY
    push BC

_sw_poll:
    ; Scan all entry queues belonging to current task
    ld IX, _entry_array
    ld B, MAX_ENTRIES
    ld C, 0             ; C = alternative index

_sw_check:
    ; Check if this EQD belongs to current task
    ld HL, (_task_cur)
    ld A, (IX+EQD_TASK_ID)
    cp L
    jr NZ, _sw_next
    ld A, (IX+EQD_TASK_ID+1)
    cp H
    jr NZ, _sw_next

    ; This entry belongs to current task - try conditional read
    push BC             ; save loop counter and index
    push IX             ; save EQD pointer

    ; Set up UQCB with this queue's name
    push IX
    pop HL
    ld DE, EQD_QUEUE_NAME
    add HL, DE          ; HL = queue name
    ld DE, _uqcb + UQCB_NAME
    ld BC, 8
    ldir

    ; Set message address
    ld HL, _qmsg_buf
    ld (_uqcb + UQCB_MSGADR), HL

    ; Open queue
    ld C, B_QOPEN
    ld DE, _uqcb
    call BDOS

    ; Conditional read (non-blocking)
    ld C, B_QCREAD
    ld DE, _uqcb
    call BDOS

    pop IX              ; restore EQD pointer
    pop BC              ; restore loop counter and index

    ; A = 0 means message was read successfully
    or A
    jr Z, _sw_found

_sw_next:
    ld DE, EQD_SIZE
    add IX, DE
    inc C               ; next alternative index
    djnz _sw_check

    ; No queues had pending messages - yield and retry
    ld C, B_PDISPATCH
    call BDOS
    jr _sw_poll

_sw_found:
    ; C = index of the alternative with a pending message
    ld H, 0
    ld L, C

    pop BC
    pop IY
    pop IX
    ret

; _SELC_EN: End a select statement
_SELC_EN:
    ret

; -----------------------------------------
; Protected Object Support (using MX queues)
; -----------------------------------------
; Protected objects use MX (mutual exclusion) queues.
; A protected object has a UQCB pointer at offset 0 (2 bytes).
; Acquiring the lock = Q_READ from the MX queue (blocks if held).
; Releasing the lock = Q_WRITE to the MX queue (unblocks waiters).
; The MX queue is pre-loaded with one 2-byte message so the first
; reader succeeds immediately.

; _PROT_LCK: Acquire protected object lock
; Protected object address is on the stack (matching protlock.mac API)
; -----------------------------------------
_PROT_LCK:
    pop DE              ; return address
    pop HL              ; protected object address
    push DE             ; restore return address

    push IX

    ; HL = protected object, offset 0 has UQCB address
    ld E, (HL)
    inc HL
    ld D, (HL)          ; DE = UQCB address

    ; Set UQCB message address to our MX buffer
    push DE
    pop IX              ; IX = UQCB
    ld HL, _mx_msg_buf
    ld (IX+UQCB_MSGADR), L
    ld (IX+UQCB_MSGADR+1), H

    ; Blocking read from MX queue = acquire lock
    push IX
    pop DE              ; DE = UQCB address
    ld C, B_QREAD
    call BDOS

    pop IX
    ret

; _PROT_ULK: Release protected object lock
; Protected object address is on the stack (matching protlock.mac API)
; -----------------------------------------
_PROT_ULK:
    pop DE              ; return address
    pop HL              ; protected object address
    push DE             ; restore return address

    push IX

    ; HL = protected object, offset 0 has UQCB address
    ld E, (HL)
    inc HL
    ld D, (HL)          ; DE = UQCB address

    ; Set UQCB message address to our MX buffer
    push DE
    pop IX              ; IX = UQCB
    ld HL, _mx_msg_buf
    ld (IX+UQCB_MSGADR), L
    ld (IX+UQCB_MSGADR+1), H

    ; Write to MX queue = release lock
    push IX
    pop DE              ; DE = UQCB address
    ld C, B_QWRITE
    call BDOS

    pop IX
    ret

; =========================================
; Internal Helper Functions
; =========================================

; -----------------------------------------
; _get_task_desc: Get task descriptor for task ID
; Input: HL = task ID (index)
; Output: HL = task descriptor address (0 if invalid)
; -----------------------------------------
_get_task_desc:
    ; Check bounds
    ld A, H
    or A
    jr NZ, _gtd_invalid ; ID too large
    ld A, L
    cp MAX_TASKS
    jr NC, _gtd_invalid

    ; Calculate address: _task_array + (ID * TD_SIZE)
    ; TD_SIZE = 32, so multiply by 32 (shift left 5 times)
    ld H, 0
    add HL, HL
    add HL, HL
    add HL, HL
    add HL, HL
    add HL, HL
    ld DE, _task_array
    add HL, DE
    ret

_gtd_invalid:
    ld HL, 0
    ret

; -----------------------------------------
; _get_ticks: Get current tick count
; Output: HL = tick count
; -----------------------------------------
_get_ticks:
    ld HL, (_tick_cnt)
    ret

; -----------------------------------------
; _find_entry_queue: Find entry queue for entry
; Input: HL = task_id, DE = entry_id
; Output: HL = EQD address (0 if not found)
; -----------------------------------------
_find_entry_queue:
    push IX
    push BC
    push DE             ; save entry_id
    push HL             ; save task_id

    ld IX, _entry_array
    ld B, MAX_ENTRIES

_feq_loop:
    ; Check if this slot matches
    ld A, (IX+EQD_TASK_ID)
    ld C, A
    ld A, (IX+EQD_TASK_ID+1)
    or C
    jr Z, _feq_next     ; Empty slot

    ; Check task_id match
    pop HL              ; task_id
    push HL
    ld A, (IX+EQD_TASK_ID)
    cp L
    jr NZ, _feq_next
    ld A, (IX+EQD_TASK_ID+1)
    cp H
    jr NZ, _feq_next

    ; Check entry_id match
    pop HL              ; discard task_id
    pop DE              ; entry_id
    push DE
    push HL
    ld A, (IX+EQD_ENTRY_ID)
    cp E
    jr NZ, _feq_next
    ld A, (IX+EQD_ENTRY_ID+1)
    cp D
    jr NZ, _feq_next

    ; Found it!
    push IX
    pop HL
    pop DE              ; discard task_id
    pop DE              ; discard entry_id
    pop BC
    pop IX
    ret

_feq_next:
    ld DE, EQD_SIZE
    add IX, DE
    djnz _feq_loop

    ; Not found
    pop HL              ; discard task_id
    pop DE              ; discard entry_id
    ld HL, 0
    pop BC
    pop IX
    ret

; -----------------------------------------
; _create_entry_queue: Create new entry queue
; Input: HL = task_id, DE = entry_id
; Output: HL = EQD address (0 on failure)
;
; Allocates a QCB with linked queue buffer from heap,
; initializes the free list, and calls Q_MAKE.
; -----------------------------------------
_create_entry_queue:
    push IX
    push IY
    push BC
    push DE             ; save entry_id
    push HL             ; save task_id

    ; Find empty slot
    ld IX, _entry_array
    ld B, MAX_ENTRIES

_ceq_find:
    ld A, (IX+EQD_TASK_ID)
    ld C, A
    ld A, (IX+EQD_TASK_ID+1)
    or C
    jr Z, _ceq_found
    ld DE, EQD_SIZE
    add IX, DE
    djnz _ceq_find

    ; No free slot
    pop HL
    pop DE
    ld HL, 0
    pop BC
    pop IY
    pop IX
    ret

_ceq_found:
    ; IX = free EQD slot
    pop HL              ; task_id
    ld (IX+EQD_TASK_ID), L
    ld (IX+EQD_TASK_ID+1), H

    pop DE              ; entry_id
    ld (IX+EQD_ENTRY_ID), E
    ld (IX+EQD_ENTRY_ID+1), D

    ; Set message parameters
    ld (IX+EQD_MSG_COUNT), NMBMSGS
    ld (IX+EQD_MSG_SIZE), EM_SIZE

    ; Generate unique queue name "QnnEmm  "
    ld (IX+EQD_QUEUE_NAME), 'Q'
    ld A, L             ; task_id low
    add A, '0'
    ld (IX+EQD_QUEUE_NAME+1), A
    ld A, H
    add A, '0'
    ld (IX+EQD_QUEUE_NAME+2), A
    ld (IX+EQD_QUEUE_NAME+3), 'E'
    ld A, E             ; entry_id low
    add A, '0'
    ld (IX+EQD_QUEUE_NAME+4), A
    ld A, D
    add A, '0'
    ld (IX+EQD_QUEUE_NAME+5), A
    ld (IX+EQD_QUEUE_NAME+6), ' '
    ld (IX+EQD_QUEUE_NAME+7), ' '

    ; Allocate QCB + buffer from heap
    ; Total = QCB_HDR_SIZE + (EM_SIZE + 2) * NMBMSGS
    ;       = 24 + 18 * 4 = 24 + 72 = 96 bytes
    push IX             ; save EQD pointer
    ld HL, QCB_HDR_SIZE + (EM_SLOT_SIZE * NMBMSGS)
    call _heap_alloc
    pop IX              ; restore EQD pointer
    ld A, H
    or L
    jr Z, _ceq_fail

    ; HL = QCB address (heap-allocated)
    ; Store QCB address in EQD
    ld (IX+EQD_QCB_ADDR), L
    ld (IX+EQD_QCB_ADDR+1), H

    push HL
    pop IY              ; IY = QCB address

    ; Clear QCB header
    push IY
    pop HL
    push HL
    pop DE
    inc DE
    ld BC, QCB_HDR_SIZE - 1
    ld (HL), 0
    ldir

    ; Fill in QCB fields
    ; QL = 0 (already zeroed)
    ; Copy queue name from EQD
    push IX
    pop HL
    ld DE, EQD_QUEUE_NAME
    add HL, DE          ; HL = source (queue name)
    push IY
    pop DE
    push DE             ; save QCB base
    ld DE, QCB_NAME
    pop BC              ; BC = QCB base
    push BC
    push HL             ; save source
    ld HL, 0
    add HL, BC
    ld DE, QCB_NAME
    add HL, DE          ; HL = &QCB.NAME
    ex DE, HL           ; DE = dest
    pop HL              ; HL = source
    ld BC, 8
    ldir

    pop HL              ; HL = QCB base (was saved as BC above)
    push HL
    pop IY              ; IY = QCB

    ; MSGLEN = EM_SIZE
    ld (IY+QCB_MSGLEN), EM_SIZE
    ld (IY+QCB_MSGLEN+1), 0

    ; NMBMSGS
    ld (IY+QCB_NMBMSGS), NMBMSGS
    ld (IY+QCB_NMBMSGS+1), 0

    ; DQPH, NQPH, MH, MT = 0 (already zeroed)

    ; Initialize buffer free list at QCB+24
    ; Each slot is EM_SLOT_SIZE (18) bytes: 2-byte link + EM_SIZE data
    ; Link each slot to the next; last slot link = 0
    push IY
    pop HL
    ld DE, QCB_BUF
    add HL, DE          ; HL = first slot address

    ; Set BH (buffer head) to first slot
    ld (IY+QCB_BH), L
    ld (IY+QCB_BH+1), H

    ; Link NMBMSGS slots together
    ld B, NMBMSGS - 1   ; link first N-1 slots
_ceq_link:
    ; Current slot at HL, next slot at HL + EM_SLOT_SIZE
    push HL             ; save current slot
    ld DE, EM_SLOT_SIZE
    add HL, DE          ; HL = next slot
    ex DE, HL           ; DE = next slot
    pop HL              ; HL = current slot
    ; Store link: (current_slot + 0) = next_slot
    ld (HL), E
    inc HL
    ld (HL), D
    dec HL
    ; Move to next slot
    ex DE, HL           ; HL = next slot
    djnz _ceq_link

    ; Terminate last slot's link with 0
    ld (HL), 0
    inc HL
    ld (HL), 0

    ; Call Q_MAKE (BDOS 134) with DE = QCB address
    push IY
    pop DE              ; DE = QCB address
    ld C, B_QMAKE
    call BDOS

    ; A = 0 on success
    or A
    jr NZ, _ceq_fail

    ; Return EQD address
    push IX
    pop HL

    pop BC
    pop IY
    pop IX
    ret

_ceq_fail:
    ; Clear the slot
    xor A
    ld (IX+EQD_TASK_ID), A
    ld (IX+EQD_TASK_ID+1), A
    ld HL, 0
    pop BC
    pop IY
    pop IX
    ret

; =========================================
; Additional Stubs for Protected Types and Parallel Blocks
; =========================================

; -----------------------------------------
; _PROT_ENQ: Queue entry call for protected entry
; Input: HL = protected object, DE = entry_id
; For MP/M, uses message queue for entry calls
; -----------------------------------------
_PROT_ENQ:
    ; For now, stub - protected entries use same queue mechanism
    ; as task entries but with protected object as target
    push IX
    push IY
    ; TODO: Implement protected entry queuing
    pop IY
    pop IX
    ret

; -----------------------------------------
; _PROT_REB: Re-evaluate barrier conditions
; Input: HL = protected object
; Checks if any waiting entry callers can now proceed
; -----------------------------------------
_PROT_REB:
    ; For now, stub - would check barrier conditions
    ; and wake waiters whose conditions are now true
    ret

; -----------------------------------------
; _REQUEUE: Requeue an entry call
; Stack: [ret] entry_ptr, with_abort_flag
; -----------------------------------------
_REQUEUE:
    ; Pop parameters
    pop DE              ; return address
    pop HL              ; entry_ptr
    pop BC              ; with_abort_flag
    push DE             ; restore return
    ; TODO: Implement requeue - transfer current entry call
    ; to the specified entry
    ret

; -----------------------------------------
; Parallel Block Support (Ada 2022)
; On MP/M, parallel blocks could spawn processes,
; but for now we execute sequentially (stub)
; -----------------------------------------

; _PAR_STR: Start parallel block
; Input: Stack = [ret] num_sequences
_PAR_STR:
    ret

; _PAR_SST: Parallel sequence start
; Input: Stack = [ret] sequence_index
_PAR_SST:
    ret

; _PAR_SEN: Parallel sequence end
; Input: Stack = [ret] sequence_index
_PAR_SEN:
    ret

; _PAR_END: End parallel block (wait for all)
_PAR_END:
    ret

    END
